### 6. CREATE TICKETS ###
###############################################

### Create Ticket 1 (Creator ID: 1, Technician ID: 1)
POST {{baseUrl}}/tickets
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "creatorId": 1,
  "technicianId": 1,
  "title": "Email Server Down",
  "description": "Email server is not responding, clients cannot send or receive emails",
  "category": "INFRASTRUCTURE",
  "priority": "HIGH",
  "status": "OPEN"
}

